# Supabase Credentials (Required for Private Storage, Catalog, and Anonymous Auth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_PROJECT_ID=your-project-id

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Groq Cloud AI Integration (Optional)
# If GROQ_API_KEY is not set or times out, the system automatically uses the zero-cost
# deterministic fallback model complying with all synthetic catalog and contract rules.
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
